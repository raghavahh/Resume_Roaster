#!/bin/sh
# Blocks any commit whose staged changes contain a secret (PRD C3, T13).
# Fails closed: no gitleaks means no commit.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit is blocked." >&2
  echo "Install it with: winget install --id Gitleaks.Gitleaks -e" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner --verbose
